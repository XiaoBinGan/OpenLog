# ─── OpenLog 环境变量示例 ───────────────────────────────────────────────
# 复制为 .env 后按需修改：  cp .env.example .env
# .env 已被 .gitignore 忽略，切勿把真实密钥提交进仓库。

# ── 服务监听 ──────────────────────────────────────────────────────────
# 端口。必须与 Dockerfile 的 EXPOSE / docker-compose 的端口映射一致。
PORT=3011

# 绑定地址。默认 127.0.0.1（仅本机可访问，最安全）。
# 需要从其他机器访问面板时才改成 0.0.0.0，并同时配置下面的 TOKEN 与 ORIGINS。
HOST=127.0.0.1

NODE_ENV=development

# ── 鉴权（生产模式强制）───────────────────────────────────────────────
# 生产模式（NODE_ENV=production）下所有 /api 与 /ws 请求都必须携带此 token。
# 生成方式：
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
# 留空则每次启动随机生成并写入 data/.auth_token（仅本地开发适用）。
OPENLOG_TOKEN=

# ── 凭据加密密钥 ──────────────────────────────────────────────────────
# 用于加密存储的 SSH 密码与模型 API Key。
# 不设置时会回退到源码内置的固定密钥 —— 等同于没有加密，任何拿到源码的人都能解密。
# ⚠️ 从「未设置」切换到「已设置」会触发一次性数据迁移（单向）：设置后不要再取消，
#    否则此前已重新加密的凭据将无法解读。
OPENLOG_SECRET_KEY=

# ── CORS 来源白名单 ───────────────────────────────────────────────────
# 逗号分隔。留空则只允许 localhost / 127.0.0.1 / ::1 以及不带 Origin 的请求。
# 例：OPENLOG_ALLOWED_ORIGINS=http://192.168.1.10:5173,http://openlog.lan
OPENLOG_ALLOWED_ORIGINS=

# ── 数据库（默认 SQLite；规模化推荐 PostgreSQL）──────────────────────
# 不设置任何 OPENLOG_DB_* → 本地 SQLite（data/openlog.db，WAL 模式）
# 显式指定了库却连不上会**直接报错**，不会静默回退到 SQLite。
#
# PostgreSQL（连接池，推荐 500 台以上 / 多实例共享）：
#   OPENLOG_DB_TYPE=postgres
#   OPENLOG_DATABASE_URL=postgres://openlog:密码@127.0.0.1:5432/openlog
#   OPENLOG_PG_POOL_MAX=10
# 或者用分字段配置：
#   OPENLOG_PG_HOST / OPENLOG_PG_PORT / OPENLOG_PG_USER / OPENLOG_PG_PASSWORD / OPENLOG_PG_DATABASE
#
# MySQL（连接池）：
#   OPENLOG_DB_TYPE=mysql
#   OPENLOG_DATABASE_URL=mysql://user:pass@127.0.0.1:3306/openlog
#
# 从 SQLite 迁到 PostgreSQL：
#   OPENLOG_DB_TYPE=postgres OPENLOG_DATABASE_URL=... \
#     node scripts/migrate-sqlite-to-pg.mjs
OPENLOG_DB_TYPE=
OPENLOG_DATABASE_URL=
OPENLOG_PG_POOL_MAX=

# ── 规模相关（1000 台服务器量级）──────────────────────────────────────
# 状态采集：服务端限并发统一采集，前端只拉快照（不再每台一个请求）
OPENLOG_STATS_INTERVAL_MS=30000
OPENLOG_STATS_CONCURRENCY=16
OPENLOG_MFU_INTERVAL_MS=60000
# SSH 连接池：常驻上限 + 空闲回收（超出按 LRU 关闭，需要时按需重连）
# 实测：单连接 ≈ 64KB RSS + 1 个 FD（1000 并发实测 23.6MB / 839 FD）。
# 所以连接数不是瓶颈，真正的坑是「上限 < 服务器数」——那样每轮采集都会 LRU 驱逐 +
# 重新握手（实测单次握手 197ms）。1000 台建议 1200。
OPENLOG_MAX_SSH_CONNECTIONS=1200
OPENLOG_SSH_IDLE_TTL_MS=600000
OPENLOG_SSH_READY_TIMEOUT_MS=10000
# 自动重连：限并发 + 每轮限量（旧实现串行，1000 台时一轮要数小时）
OPENLOG_RECONNECT_CONCURRENCY=16
OPENLOG_RECONNECT_MAX_PER_PASS=64
OPENLOG_STARTUP_CONNECT_CONCURRENCY=16

# ── 运维助手长任务预算（任务太长会退出的修复）─────────────────────────
# 单次对话最多多少轮工具调用（旧实现硬编码 10，长任务必被砍）
OPENLOG_ASSISTANT_MAX_ROUNDS=30
# 单次任务总时长上限（毫秒），超时会先给阶段性总结再结束
OPENLOG_ASSISTANT_MAX_WALL_MS=600000
# 上下文预算（tokens）：超过就把早期工具结果压成摘要，避免撞模型窗口
OPENLOG_ASSISTANT_CONTEXT_TOKENS=48000
# 单条工具结果进上下文的最大字符数（越大越容易撞窗口）
OPENLOG_ASSISTANT_TOOL_RESULT_CHARS=6000
# 单轮模型响应超时（毫秒），超时重试一次，连续两次则收尾
OPENLOG_ASSISTANT_ROUND_TIMEOUT_MS=180000

# ── 容器内命令执行（Docker 页面「容器内执行命令」面板）──────────────
# 控制 POST /api/docker/:sourceId/:containerId/exec
#
# 只允许只读白名单命令（ls/cat/head/tail/ps/grep/...），并禁止 shell 元字符
# （; | && $( ) ` > < 换行），命令不走 shell。默认关闭；Docker 页面终端面板
# 需要它才能工作，关闭时面板会明确提示「容器内命令执行未启用」。
# 与下面的 OPENLOG_ENABLE_REMOTE_EXEC 独立：可以只开面板、不开 SSH 远程执行。
# 只接受精确值 1。
OPENLOG_ENABLE_CONTAINER_EXEC=

# ── REST 远程命令执行（默认关闭，谨慎开启）────────────────────────────
# 控制这三个端点：POST /api/remote/servers/:id/exec、.../shell、/api/remote/:id/aishell
#
# 默认关闭。原因：「元字符过滤 + 命令名白名单」不是安全边界 —— 命令名合法的前提下，
#   find / -exec id {} +  /  awk 'BEGIN{system("id")}'  /  sed '1e id' / sed -i
# 都能以 SSH 用户身份执行任意命令或改写文件；sort -o、date -s、hostname、dmesg -C、
# journalctl --vacuum-*、ip link set 等则能写文件或改系统状态。
#
# 前端界面并不使用这三个端点（UI 走 WS 终端 /ws/shell 与 WS AI Shell /ws/aishell），
# 因此默认关闭不影响任何页面功能。仅当确有外部脚本需要调用时才开启。
# 只接受精确值 1（true/yes/01 等都不会生效）。
OPENLOG_ENABLE_REMOTE_EXEC=

# ── 日志监控目录 ──────────────────────────────────────────────────────
# 本机默认 ~/logs；容器内应为 /app/logs（对应 compose 的 ./logs 挂载）。
LOG_PATH=

# ── 模型配置（仅首次启动、数据库尚无配置时作为默认值）─────────────────
# 页面「设置」中填写的值会持久化到数据库并优先生效，此处的值不会覆盖已有配置。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini

# ── 数据与配置文件位置 ────────────────────────────────────────────────
# 不设置时：数据库在 ./data/openlog.db，配置文件在项目根目录。
# 测试与多实例部署建议显式指向隔离目录 —— 否则 `npm test` 会直接读写生产库。
# OPENLOG_DATA_DIR=/var/lib/openlog/data
# OPENLOG_SETTINGS_PATH=/var/lib/openlog/settings.json
# REMOTE_CONFIG_PATH=/var/lib/openlog/remote-servers.json

# ── 过期状态清理间隔（毫秒，默认 60000）───────────────────────────────
# 用于回收分析防抖 / 限流 / 告警冷却等以无界键增长的 Map，一般无需修改。
# OPENLOG_MAINTENANCE_INTERVAL_MS=60000

# ── 容器内查询宿主机 GPU（可选）──────────────────────────────────────
# 容器里通常没有 nvidia-smi。配置以下变量后，GPU 查询会 SSH 到宿主机执行。
#
# 重要行为变更：此前这组凭据是【明文硬编码在 server/index.js 里】的
# （4 处，且已提交进 git 历史）。现已全部移除 —— 不配置就没有回落，
# 不再有源码内置的后备密码。
#
# 用 KEY_PATH 优先于 PASSWORD。密码通过 sshpass -e 从环境变量读取，
# 不会出现在 `ps` 的进程列表里（旧的 `sshpass -p` 会）。
# OPENLOG_GPU_SSH_HOST=127.0.0.1
# OPENLOG_GPU_SSH_PORT=40022
# OPENLOG_GPU_SSH_USER=your-ssh-user
# OPENLOG_GPU_SSH_KEY_PATH=/root/.ssh/id_ed25519
# OPENLOG_GPU_SSH_PASSWORD=
# 主机密钥策略，默认 accept-new（首次记录、之后校验）。
# 旧的硬编码实现用的是 no，等于无条件信任任何主机密钥。
# OPENLOG_GPU_SSH_STRICT=accept-new
