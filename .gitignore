# 依赖目录
# 通过 package.json 可以重新安装，体积巨大，无需提交
node_modules/

# 环境变量文件
# 包含数据库密码、API密钥等敏感信息，严禁提交
.env
.env.local
.env.*.local
# 部署配置（含数据库密码）与部署备份
deploy.env
deploy/deploy.env
.deploy.json
deploy/.deploy.json
backups/
# 镜像归档（体积大，不进 git；只保留清单 MANIFEST.md 和脚本）
deploy/images/*.tar
deploy/images/*.tar.gz
deploy/images/postgres-*.tar.gz
# 分发用部署包（含镜像，体积大，按需生成）
openlog-deploy-*.tar
openlog-deploy-*.tar.gz

# macOS 系统文件
# 存储文件夹显示属性，与项目代码无关，会造成不必要的冲突
.DS_Store
# 本地配置文件（用户私有，不要提交）
settings.json
remote-servers.json

# 构建产物
dist/
client/dist/
vite.log
*.tsbuildinfo

# 运行时日志（由程序生成，不应提交）
*.log

# 本地数据库
data/

# Go 后端（在 golang 分支）
server_go/

# 编辑器配置
.claude/
.vscode/
.idea/
__pycache__/
coverage/

# 本地部署临时文件（git bundle / 部署脚本）
_deploy/
