# ─── OpenLog 部署配置（服务端）─────────────────────────────────────────
#
# 从本文件复制为 deploy.env 并填写真实值：
#     cp deploy.env.example deploy.env
#     chmod 600 deploy.env
#
# ⚠️ deploy.env 含数据库密码等敏感信息，已在 .gitignore 里排除，不要提交。

# ── 应用 ──────────────────────────────────────────────────────────────
# 宿主机端口（docker --network host 时就是应用监听端口）
APP_PORT=3001
HOST_BIND=0.0.0.0
# 数据目录（宿主机绝对路径，挂到容器 /app/data）
DATA_DIR=/workspace/Openlog-new/data
# 日志卷名（docker volume，挂到容器 /app/logs）
LOGS_VOLUME=openlog-logs
# 网络模式：host（默认，docker-over-SSH 需要）；也可 bridge
NETWORK_MODE=host

# ── 数据库 ────────────────────────────────────────────────────────────
# sqlite：留空 OPENLOG_DB_TYPE 即可（数据在 $DATA_DIR/openlog.db）
# postgres：容器名约定 openlog-pg（备份脚本按这个名字 pg_dump）
OPENLOG_DB_TYPE=postgres
OPENLOG_DATABASE_URL=postgres://openlog:改成你的密码@127.0.0.1:5432/openlog
OPENLOG_PG_POOL_MAX=10

# ── 功能开关 ──────────────────────────────────────────────────────────
# Docker 页面「容器内执行命令」面板（只读白名单）
OPENLOG_ENABLE_CONTAINER_EXEC=1
# REST 远程命令执行（外部脚本用，默认关闭）
# OPENLOG_ENABLE_REMOTE_EXEC=
# 访问令牌：不设置则自动生成到 $DATA_DIR/.auth_token
# OPENLOG_TOKEN=
# 凭据加密密钥：设置后不要再取消（单向迁移）
# OPENLOG_SECRET_KEY=
# 浏览器来源白名单（逗号分隔）
# OPENLOG_ALLOWED_ORIGINS=

# ── 规模 / 预算（可选，不填用代码默认值）──────────────────────────────
# OPENLOG_STATS_CONCURRENCY=16
# OPENLOG_MAX_SSH_CONNECTIONS=1200
# OPENLOG_ASSISTANT_MAX_ROUNDS=30

# ── 额外自定义环境变量（空格分隔的 KEY=VALUE）─────────────────────────
# EXTRA_ENV="FOO=1 BAR=2"
