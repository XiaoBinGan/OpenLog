{
  "name": "openlog",
  "version": "1.0.0",
  "description": "智能日志分析与监控系统 - AI-Powered Log Analysis & Monitoring",
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/ensure-sqlite-binding.js",
    "init-db": "node scripts/init-db.js",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "client": "npm run dev --prefix client",
    "server": "node server/index.js",
    "build": "npm run build --prefix client",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:client": "npm run lint --prefix client",
    "lint:all": "npm run lint && npm run lint:client",
    "start": "node scripts/start-prod.js",
    "start:posix": "NODE_ENV=production node server/index.js",
    "deploy": "node scripts/deploy.mjs",
    "deploy:logs": "node scripts/deploy.mjs --logs"
  },
  "engines": {
    "node": ">=22.22"
  },
  "dependencies": {
    "better-sqlite3": "^12.9.0",
    "chokidar": "^3.6.0",
    "cors": "^2.8.5",
    "dockerode": "^4.0.12",
    "dotenv": "^16.4.1",
    "express": "^4.18.2",
    "mysql2": "^3.22.2",
    "node-ssh": "^13.2.1",
    "openai": "^4.104.0",
    "pg": "^8.20.0",
    "systeminformation": "^5.31.5",
    "uuid": "^9.0.1",
    "ws": "^8.16.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@vitest/coverage-v8": "^3.1.1",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.1",
    "globals": "^16.5.0",
    "jsdom": "^30.1.2",
    "vitest": "^3.1.1"
  }
}
